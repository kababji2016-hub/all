{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "modules/_template/**"],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/finance", "destination": "/modules/finance/index.html" },
      { "source": "/payroll", "destination": "/modules/payroll/index.html" },
      { "source": "/docs", "destination": "/modules/docs/index.html" },
      { "source": "/journal", "destination": "/modules/journal/index.html" }
    ],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/core/**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
